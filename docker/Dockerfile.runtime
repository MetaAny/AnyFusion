# syntax=docker/dockerfile:1.7

FROM node:22.19.0-bookworm-slim AS planner-builder

WORKDIR /planner
ENV CI=true

COPY --from=anyfusion-pi package.json package-lock.json ./
COPY --from=anyfusion-pi packages/tui/package.json packages/tui/package.json
COPY --from=anyfusion-pi packages/ai/package.json packages/ai/package.json
COPY --from=anyfusion-pi packages/agent/package.json packages/agent/package.json
COPY --from=anyfusion-pi packages/coding-agent/package.json packages/coding-agent/package.json
RUN npm ci --ignore-scripts

COPY --from=anyfusion-pi . .
RUN npm run build:offline \
  && mkdir -p /opt/anyfusion-planner/app /opt/anyfusion-planner/bin \
  && cp -a package.json package-lock.json node_modules packages /opt/anyfusion-planner/app/ \
  && printf '%s\n' '#!/bin/sh' 'exec /usr/local/bin/node /opt/anyfusion-planner/app/packages/coding-agent/dist/cli.js "$@"' > /opt/anyfusion-planner/bin/anyfusion-planner \
  && chmod +x /opt/anyfusion-planner/bin/anyfusion-planner

FROM docker:27-cli AS docker-cli

FROM node:22.19.0-bookworm-slim AS builder

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22.19.0-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    CI=true \
    METACLAW_HOME=/data/metaclaw \
    ANYFUSION_PLANNER_HOME=/var/lib/metaclaw/anyfusion-planner/agent \
    METACLAW_PLANNER_HOME=/var/lib/metaclaw/anyfusion-planner/agent \
    METACLAW_PLANNER_SESSION_DIR=/var/lib/metaclaw/anyfusion-planner/sessions \
    METACLAW_PLANNER_SCHEMA_PATH=/opt/metaclaw/schema/planning-agent-plan-v7.schema.json \
    ANYFUSION_PLANNER_SCHEMA_PATH=/opt/metaclaw/schema/planning-agent-plan-v7.schema.json \
    METACLAW_PLANNER_WORKDIR=/workspace \
    METACLAW_PLANNER_ENV_FILE=/run/metaclaw/env/planner-pi.env \
    METACLAW_PLANNER_COMMAND=/opt/anyfusion-planner/bin/anyfusion-planner \
    METACLAW_PLANNER_TUI_COMMAND=/opt/anyfusion-planner/bin/anyfusion-planner \
    METACLAW_PLANNER_TUI_SOCKET=/data/metaclaw/anyfusion-planner.sock \
    ANYFUSION_BRIDGE_SOCKET=/data/metaclaw/anyfusion-planner.sock \
    ANYFUSION_PLANNER_MODE=1 \
    METACLAW_EXECUTOR_BACKEND=worktree \
    METACLAW_EXECUTOR_CODEX_HOME=/var/lib/metaclaw/codex/executor \
    METACLAW_EXECUTOR_PI_HOME=/root \
    METACLAW_CODEX_EXECUTOR_ENV_FILE=/run/metaclaw/env/executor-codex.env \
    METACLAW_PI_EXECUTOR_ENV_FILE=/run/metaclaw/env/executor-pi.env

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl fd-find git openssh-client openssh-server python3 ripgrep \
  && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /run/sshd \
  && echo 'root:metaclaw' | chpasswd \
  && sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
  && sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
  && npm install -g --ignore-scripts @openai/codex@0.144.1 @earendil-works/pi-coding-agent@0.80.2

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/dist/pi-attempt-tools.ts /opt/metaclaw/pi-attempt-tools.ts
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=planner-builder /opt/anyfusion-planner /opt/anyfusion-planner
COPY docker/entrypoint.sh /opt/metaclaw/entrypoint.sh
COPY docker/persist-ssh-environment.sh /opt/metaclaw/persist-ssh-environment.sh
COPY docker/codex-config/executor /opt/metaclaw/codex-config/executor
COPY docker/pi-config /opt/metaclaw/pi-config
COPY docker/planner-pi-config /opt/metaclaw/planner-pi-config
COPY docker/tui-config.yaml /opt/metaclaw/default-config.yaml
COPY scripts/smoke-planner-mcp.mjs /app/scripts/smoke-planner-mcp.mjs
COPY scripts/smoke-metaclaw-real-task.mjs /app/scripts/smoke-metaclaw-real-task.mjs
COPY --from=builder /app/dist/planning-agent-plan-v7.schema.json /opt/metaclaw/schema/planning-agent-plan-v7.schema.json

RUN test "$(node --version)" = 'v22.19.0' \
  && test ! -e /opt/anyfusion-planner/node \
  && test -d /app/node_modules \
  && test -d /opt/anyfusion-planner/app/node_modules \
  && printf '#!/bin/sh\nexec node /app/dist/capability-request-cli.js "$@"\n' > /usr/local/bin/request_capability \
  && printf '#!/bin/sh\nexec node /app/dist/capability-use-cli.js "$@"\n' > /usr/local/bin/use_capability \
  && sed -i 's/\r$//' /opt/metaclaw/entrypoint.sh /opt/metaclaw/persist-ssh-environment.sh \
  && chmod +x /opt/metaclaw/entrypoint.sh /usr/local/bin/request_capability /usr/local/bin/use_capability \
  && mkdir -p /data/metaclaw /workspace /var/empty/metaclaw-planner /var/lib/metaclaw/anyfusion-planner/agent /var/lib/metaclaw/anyfusion-planner/sessions

VOLUME ["/data", "/workspace"]
EXPOSE 22
WORKDIR /workspace
ENTRYPOINT ["/opt/metaclaw/entrypoint.sh"]
CMD ["node", "/app/dist/index.js"]
