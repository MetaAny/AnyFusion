# syntax=docker/dockerfile:1.7

ARG UBUNTU_IMAGE=ubuntu:24.04@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea
FROM ${UBUNTU_IMAGE} AS node-base

ARG NODE_VERSION=22.19.0
ARG NODE_SHA256=c0649af18e6a24f6fe5535a3e86b341dd49a8e71117c8b68bde973ef834f16f2
ENV DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
  apt-get -o Acquire::Retries=5 update; \
  apt-get -o Acquire::Retries=5 install -y --no-install-recommends ca-certificates; \
  sed -i -e 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g' -e 's|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources; \
  apt-get -o Acquire::Retries=5 update; \
  attempt=1; \
  until apt-get -o Acquire::Retries=5 install -y --no-install-recommends curl xz-utils; do \
    if [ "$attempt" -ge 3 ]; then exit 1; fi; \
    attempt=$((attempt + 1)); \
    apt-get -o Acquire::Retries=5 update; \
  done; \
  curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz"; \
  echo "${NODE_SHA256}  node-v${NODE_VERSION}-linux-x64.tar.xz" | sha256sum -c -; \
  tar -xJf "node-v${NODE_VERSION}-linux-x64.tar.xz" -C /usr/local --strip-components=1; \
  rm "node-v${NODE_VERSION}-linux-x64.tar.xz"; \
  npm install -g npm@10.9.3; \
  test "$(node --version)" = 'v22.19.0'; \
  test "$(npm --version)" = '10.9.3'; \
  rm -rf /var/lib/apt/lists/*

FROM node-base AS planner-builder

WORKDIR /planner
ENV CI=true

COPY --from=anyfusion-pi package.json package-lock.json ./
COPY --from=anyfusion-pi packages/tui/package.json packages/tui/package.json
COPY --from=anyfusion-pi packages/ai/package.json packages/ai/package.json
COPY --from=anyfusion-pi packages/agent/package.json packages/agent/package.json
COPY --from=anyfusion-pi packages/coding-agent/package.json packages/coding-agent/package.json
RUN npm ci --ignore-scripts

COPY --from=anyfusion-pi . .
RUN npm run build:offline \
  && mkdir -p /opt/anyfusion-planner/app /opt/anyfusion-planner/bin \
  && cp -a package.json package-lock.json node_modules packages /opt/anyfusion-planner/app/ \
  && printf '%s\n' '#!/bin/sh' 'exec /usr/local/bin/node /opt/anyfusion-planner/app/packages/coding-agent/dist/cli.js "$@"' > /opt/anyfusion-planner/bin/anyfusion-planner \
  && chmod +x /opt/anyfusion-planner/bin/anyfusion-planner

FROM node-base AS builder

RUN set -eux; \
  apt-get -o Acquire::Retries=5 update; \
  attempt=1; \
  until apt-get -o Acquire::Retries=5 install -y --no-install-recommends build-essential g++ git make python3; do \
    if [ "$attempt" -ge 3 ]; then exit 1; fi; \
    attempt=$((attempt + 1)); \
    apt-get -o Acquire::Retries=5 update; \
  done; \
  rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node-base AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    CI=true \
    ANYFUSION_DATA_HOME=/data/anyfusion \
    ANYFUSION_CONFIG_HOME=/data/anyfusion/config \
    METACLAW_HOME=/data/anyfusion/runtime \
    ANYFUSION_PLANNER_HOME=/data/anyfusion/config/planner \
    METACLAW_PLANNER_HOME=/data/anyfusion/config/planner \
    METACLAW_PLANNER_SESSION_DIR=/data/anyfusion/runtime/planner-sessions \
    METACLAW_PLANNER_SCHEMA_PATH=/opt/metaclaw/schema/planning-agent-plan-v7.schema.json \
    ANYFUSION_PLANNER_SCHEMA_PATH=/opt/metaclaw/schema/planning-agent-plan-v7.schema.json \
    METACLAW_PLANNER_WORKDIR=/workspace/default \
    METACLAW_PLANNER_ENV_FILE=/run/metaclaw/env/planner-pi.env \
    METACLAW_PLANNER_COMMAND=/opt/anyfusion-planner/bin/anyfusion-planner \
    METACLAW_PLANNER_TUI_COMMAND=/opt/anyfusion-planner/bin/anyfusion-planner \
    METACLAW_PLANNER_TUI_SOCKET=/data/anyfusion/runtime/anyfusion-planner.sock \
    ANYFUSION_BRIDGE_SOCKET=/data/anyfusion/runtime/anyfusion-planner.sock \
    ANYFUSION_PLANNER_MODE=1 \
    METACLAW_EXECUTOR_CODEX_HOME=/data/anyfusion/config/codex \
    METACLAW_EXECUTOR_PI_HOME=/data/anyfusion/config/pi-home \
    METACLAW_CODEX_EXECUTOR_ENV_FILE=/run/metaclaw/env/executor-codex.env \
    METACLAW_PI_EXECUTOR_ENV_FILE=/run/metaclaw/env/executor-pi.env

RUN set -eux; \
  apt-get -o Acquire::Retries=5 update; \
  attempt=1; \
  until apt-get -o Acquire::Retries=5 install -y --no-install-recommends bash fd-find git openssh-client openssh-server python3 ripgrep tini; do \
    if [ "$attempt" -ge 3 ]; then exit 1; fi; \
    attempt=$((attempt + 1)); \
    apt-get -o Acquire::Retries=5 update; \
  done; \
  ln -sf /usr/bin/fdfind /usr/local/bin/fd; \
  rm -rf /var/lib/apt/lists/*; \
  mkdir -p /run/sshd; \
  echo 'root:metaclaw' | chpasswd; \
  printf '%s\n' 'PermitRootLogin yes' 'PasswordAuthentication yes' > /etc/ssh/sshd_config.d/anyfusion.conf; \
  npm install -g --ignore-scripts @openai/codex@0.146.0 @earendil-works/pi-coding-agent@0.81.1

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/dist/pi-attempt-tools.ts /opt/metaclaw/pi-attempt-tools.ts
COPY --from=planner-builder /opt/anyfusion-planner /opt/anyfusion-planner
COPY docker/entrypoint.sh /opt/metaclaw/entrypoint.sh
COPY docker/persist-ssh-environment.sh /opt/metaclaw/persist-ssh-environment.sh
COPY scripts/runtime-bootstrap.sh /opt/metaclaw/runtime-bootstrap.sh
COPY docker/codex-config/executor /opt/metaclaw/codex-config/executor
COPY docker/pi-config /opt/metaclaw/pi-config
COPY docker/planner-pi-config /opt/metaclaw/planner-pi-config
COPY docker/tui-config.yaml /opt/metaclaw/default-config.yaml
COPY docker/gateway-config.yaml /opt/metaclaw/gateway-config.yaml
COPY scripts/smoke-planner-mcp.mjs /app/scripts/smoke-planner-mcp.mjs
COPY scripts/smoke-metaclaw-real-task.mjs /app/scripts/smoke-metaclaw-real-task.mjs
COPY --from=builder /app/dist/planning-agent-plan-v7.schema.json /opt/metaclaw/schema/planning-agent-plan-v7.schema.json

RUN test "$(node --version)" = 'v22.19.0' \
  && test "$(npm --version)" = '10.9.3' \
  && test "$(codex --version)" = 'codex-cli 0.146.0' \
  && test "$(pi --version)" = '0.81.1' \
  && ldd --version 2>&1 | head -n 1 | grep -q '2.39' \
  && test ! -e /opt/anyfusion-planner/node \
  && test -d /app/node_modules \
  && test -d /opt/anyfusion-planner/app/node_modules \
  && printf '#!/bin/sh\nexec node /app/dist/capability-request-cli.js "$@"\n' > /usr/local/bin/request_capability \
  && printf '#!/bin/sh\nexec node /app/dist/capability-use-cli.js "$@"\n' > /usr/local/bin/use_capability \
  && sed -i 's/\r$//' /opt/metaclaw/entrypoint.sh /opt/metaclaw/persist-ssh-environment.sh /opt/metaclaw/runtime-bootstrap.sh \
  && bash -n /opt/metaclaw/entrypoint.sh /opt/metaclaw/persist-ssh-environment.sh /opt/metaclaw/runtime-bootstrap.sh \
  && chmod +x /opt/metaclaw/entrypoint.sh /opt/metaclaw/runtime-bootstrap.sh /usr/local/bin/request_capability /usr/local/bin/use_capability \
  && mkdir -p /data/anyfusion/config /data/anyfusion/runtime /workspace/default /var/empty/metaclaw-planner

VOLUME ["/data", "/workspace"]
EXPOSE 22
WORKDIR /workspace/default
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/metaclaw/entrypoint.sh"]
CMD ["node", "/app/dist/index.js", "--project", "/workspace/default"]
