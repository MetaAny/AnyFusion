FROM node:22.19.0-bookworm-slim

ENV NODE_ENV=production \
    CI=true \
    HOME=/home/node

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates git python3 ripgrep curl \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g --ignore-scripts @earendil-works/pi-coding-agent@0.80.2

COPY dist/capability-request-cli.js /opt/metaclaw/request_capability.js
COPY dist/capability-use-cli.js /opt/metaclaw/use_capability.js
COPY dist/pi-attempt-tools.ts /opt/metaclaw/pi-attempt-tools.ts
COPY docker/pi-config /opt/metaclaw/pi-config
COPY docker/attempt-pi-entrypoint.sh /opt/metaclaw/attempt-entrypoint.sh
RUN printf '#!/bin/sh\nexec node /opt/metaclaw/request_capability.js "$@"\n' > /usr/local/bin/request_capability \
  && printf '#!/bin/sh\nexec node /opt/metaclaw/use_capability.js "$@"\n' > /usr/local/bin/use_capability \
  && sed -i 's/\r$//' /opt/metaclaw/attempt-entrypoint.sh \
  && chmod 0555 /usr/local/bin/request_capability /usr/local/bin/use_capability /opt/metaclaw/request_capability.js /opt/metaclaw/use_capability.js /opt/metaclaw/attempt-entrypoint.sh

USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["/opt/metaclaw/attempt-entrypoint.sh"]
