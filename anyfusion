#!/usr/bin/env bash

# Native Linux launcher for AnyFusion.
# It replaces the Windows Docker/SSH workflow in docker/shell.ps1 when the
# repository is run directly on a Linux host.
set -Eeuo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOCKER_DIR="$REPO_ROOT/docker"
APP_ENTRY="$REPO_ROOT/dist/index.js"
PLANNER_SCHEMA="$REPO_ROOT/dist/planning-agent-plan-v4.schema.json"
PLANNER_MCP="$REPO_ROOT/dist/planner-mcp.js"

PLANNER_ENV_FILE="$DOCKER_DIR/planner-codex.env"
CODEX_EXECUTOR_ENV_FILE="$DOCKER_DIR/executor-codex.env"
PI_EXECUTOR_ENV_FILE="$DOCKER_DIR/executor-pi.env"

METACLAW_HOME="${METACLAW_HOME:-$HOME/.metaclaw}"
AGENT_RUNTIME_DIR="${ANYFUSION_AGENT_RUNTIME_DIR:-$METACLAW_HOME/agent-runtime}"
PLANNER_CODEX_HOME="$AGENT_RUNTIME_DIR/codex/planner"
EXECUTOR_CODEX_HOME="$AGENT_RUNTIME_DIR/codex/executor"
PI_AGENT_DIR="$AGENT_RUNTIME_DIR/pi"

if [[ -t 1 ]]; then
  GREEN=$'\033[0;32m'
  YELLOW=$'\033[1;33m'
  RED=$'\033[0;31m'
  RESET=$'\033[0m'
else
  GREEN=''
  YELLOW=''
  RED=''
  RESET=''
fi

info() {
  printf '%s[INFO]%s %s\n' "$GREEN" "$RESET" "$*"
}

warn() {
  printf '%s[WARN]%s %s\n' "$YELLOW" "$RESET" "$*" >&2
}

fail() {
  printf '%s[ERROR]%s %s\n' "$RED" "$RESET" "$*" >&2
  exit 1
}

show_help() {
  cat <<'EOF'
用法:
  ./anyfusion                     构建最新代码并启动 AnyFusion TUI
  ./anyfusion gateway run         前台启动 Gateway
  ./anyfusion gateway doctor      检查 Gateway 配置
  ./anyfusion --script <文件>      运行脚本任务
  ./anyfusion --check             仅检查并准备宿主机运行环境
  ./anyfusion --launcher-help     显示本帮助

环境变量:
  METACLAW_HOME                   数据目录，默认 ~/.metaclaw
  ANYFUSION_AGENT_RUNTIME_DIR     隔离的 Codex/Pi 配置目录
EOF
}

require_command() {
  local command_name="$1"
  local install_hint="$2"
  if ! command -v "$command_name" >/dev/null 2>&1; then
    fail "缺少命令 '$command_name'。$install_hint"
  fi
}

check_host_prerequisites() {
  if [[ "$(uname -s)" != 'Linux' ]]; then
    fail '此启动器仅用于 Linux 宿主机；Windows Docker 环境请继续使用 docker/shell.ps1。'
  fi

  require_command node '请安装 Node.js 20 或更高版本。'
  require_command npm '请随 Node.js 安装 npm。'
  require_command codex 'Planner 和默认 Codex 执行器依赖 Codex CLI。'
  require_command pi 'Pi 执行器依赖 Pi CLI。'

  local node_major
  node_major="$(node -p 'Number(process.versions.node.split(".")[0])')"
  if (( node_major < 20 )); then
    fail "Node.js 版本过低：$(node --version)，需要 20 或更高版本。"
  fi
}

env_file_value() {
  local env_file="$1"
  local key="$2"
  local line
  local value

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]] && continue
    if [[ "$line" =~ ^[[:space:]]*${key}[[:space:]]*=(.*)$ ]]; then
      value="${BASH_REMATCH[1]}"
      value="${value#"${value%%[![:space:]]*}"}"
      value="${value%"${value##*[![:space:]]}"}"
      if [[ "$value" == \"*\" && "$value" == *\" ]] || [[ "$value" == \'*\' && "$value" == *\' ]]; then
        value="${value:1:${#value}-2}"
      fi
      printf '%s' "$value"
      return 0
    fi
  done < "$env_file"
}

validate_provider_env() {
  local label="$1"
  local env_file="$2"

  if [[ ! -f "$env_file" ]]; then
    fail "缺少 $env_file；请从对应的 .env.example 复制并填写。"
  fi

  local api_key
  local base_url
  api_key="$(env_file_value "$env_file" OPENAI_API_KEY)"
  base_url="$(env_file_value "$env_file" OPENAI_BASE_URL)"

  [[ -n "$api_key" ]] || fail "$label 的 OPENAI_API_KEY 为空：$env_file"
  [[ -n "$base_url" ]] || fail "$label 的 OPENAI_BASE_URL 为空：$env_file"
  [[ "$base_url" != *$'\n'* && "$base_url" != *$'\r'* && "$base_url" != *'"'* ]] \
    || fail "$label 的 OPENAI_BASE_URL 含有无法写入配置文件的字符。"
}

ensure_dependencies() {
  local npm_lock="$REPO_ROOT/node_modules/.package-lock.json"
  if [[ ! -d "$REPO_ROOT/node_modules" || ! -f "$npm_lock" \
    || "$REPO_ROOT/package-lock.json" -nt "$npm_lock" \
    || "$REPO_ROOT/package.json" -nt "$npm_lock" ]]; then
    info '安装与锁文件一致的 Node.js 依赖...'
    (cd "$REPO_ROOT" && npm ci)
  fi
}

build_latest_source() {
  info '构建仓库最新代码...'
  (cd "$REPO_ROOT" && npm run build)

  [[ -f "$APP_ENTRY" ]] || fail "构建未生成 $APP_ENTRY"
  [[ -f "$PLANNER_SCHEMA" ]] || fail "构建未生成 $PLANNER_SCHEMA"
  [[ -f "$PLANNER_MCP" ]] || fail "构建未生成 $PLANNER_MCP"
}

render_template() {
  local template_path="$1"
  local output_path="$2"
  local base_url="$3"
  local content
  local docker_planner_mcp='/app/dist/planner-mcp.js'

  content="$(<"$template_path")"
  content="${content//__OPENAI_BASE_URL__/$base_url}"
  content="${content//$docker_planner_mcp/$PLANNER_MCP}"
  printf '%s\n' "$content" > "$output_path"
}

prepare_runtime_configuration() {
  local planner_base_url
  local codex_executor_base_url
  local pi_executor_base_url

  validate_provider_env 'Planner Codex' "$PLANNER_ENV_FILE"
  validate_provider_env 'Executor Codex' "$CODEX_EXECUTOR_ENV_FILE"
  validate_provider_env 'Executor Pi' "$PI_EXECUTOR_ENV_FILE"

  planner_base_url="$(env_file_value "$PLANNER_ENV_FILE" OPENAI_BASE_URL)"
  codex_executor_base_url="$(env_file_value "$CODEX_EXECUTOR_ENV_FILE" OPENAI_BASE_URL)"
  pi_executor_base_url="$(env_file_value "$PI_EXECUTOR_ENV_FILE" OPENAI_BASE_URL)"

  mkdir -p \
    "$METACLAW_HOME" \
    "$PLANNER_CODEX_HOME" \
    "$EXECUTOR_CODEX_HOME" \
    "$PI_AGENT_DIR"

  render_template \
    "$DOCKER_DIR/codex-config/planner/config.toml" \
    "$PLANNER_CODEX_HOME/config.toml" \
    "$planner_base_url"
  render_template \
    "$DOCKER_DIR/codex-config/executor/config.toml" \
    "$EXECUTOR_CODEX_HOME/config.toml" \
    "$codex_executor_base_url"
  render_template \
    "$DOCKER_DIR/pi-config/models.json" \
    "$PI_AGENT_DIR/models.json" \
    "$pi_executor_base_url"
  cp "$DOCKER_DIR/pi-config/settings.json" "$PI_AGENT_DIR/settings.json"

  rm -rf "$PLANNER_CODEX_HOME/skills"
  cp -R "$DOCKER_DIR/codex-config/planner/skills" "$PLANNER_CODEX_HOME/skills"

  if [[ ! -f "$METACLAW_HOME/config.yaml" ]]; then
    cp "$DOCKER_DIR/tui-config.yaml" "$METACLAW_HOME/config.yaml"
    info "已创建默认运行配置：$METACLAW_HOME/config.yaml"
  fi

  export METACLAW_HOME
  export METACLAW_PLANNER_ENV_FILE="$PLANNER_ENV_FILE"
  export METACLAW_CODEX_EXECUTOR_ENV_FILE="$CODEX_EXECUTOR_ENV_FILE"
  export METACLAW_PI_EXECUTOR_ENV_FILE="$PI_EXECUTOR_ENV_FILE"
  export METACLAW_PLANNER_CODEX_HOME="$PLANNER_CODEX_HOME"
  export METACLAW_EXECUTOR_CODEX_HOME="$EXECUTOR_CODEX_HOME"
  export METACLAW_PLANNER_SCHEMA_PATH="$PLANNER_SCHEMA"
  export METACLAW_PLANNER_WORKDIR="$REPO_ROOT"
  export PI_CODING_AGENT_DIR="$PI_AGENT_DIR"
  export PI_SKIP_VERSION_CHECK="${PI_SKIP_VERSION_CHECK:-1}"
  export PI_TELEMETRY="${PI_TELEMETRY:-0}"
}

main() {
  case "${1:-}" in
    --launcher-help)
      show_help
      return 0
      ;;
  esac

  cd "$REPO_ROOT"
  check_host_prerequisites
  ensure_dependencies
  build_latest_source
  prepare_runtime_configuration

  if [[ "${1:-}" == '--check' ]]; then
    info 'Linux 宿主机运行环境检查通过。'
    printf '  Repository: %s\n' "$REPO_ROOT"
    printf '  MetaClaw home: %s\n' "$METACLAW_HOME"
    printf '  Planner Codex home: %s\n' "$PLANNER_CODEX_HOME"
    printf '  Executor Codex home: %s\n' "$EXECUTOR_CODEX_HOME"
    printf '  Executor Pi home: %s\n' "$PI_AGENT_DIR"
    return 0
  fi

  info '启动 AnyFusion...'
  exec node "$APP_ENTRY" "$@"
}

main "$@"
